# Copy this file to secrets.env and paste the keys you have.
# A blank key skips that model. secrets.env is ignored by git.
# Model names must match the id each vendor currently publishes.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

XAI_API_KEY=
XAI_MODEL=grok-3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Required only when the filings are not already in dho_data/raw.
SEC_USER_AGENT=Your Name MSDS498 you@email.com
